{
  "testEnvironment": "node",
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/**/*.js",
    "!src/**/*.test.js",
    "!src/**/*.spec.js",
    "!src/core/colors.js",
    "!src/core/executor.js",
    "!src/core/logger.js",
    "!src/core/system.js",
    "!src/core/version.js"
  ],
  "testMatch": [
    "**/test/**/*.test.js",
    "**/test/**/*.spec.js",
    "**/__tests__/**/*.js",
    "**/test/cli/commands/clean.test.ts",
    "**/test/cli/commands/config.test.ts",
    "**/test/cli/commands/deploy.test.ts",
    "**/test/cli/commands/run.test.ts",
    "**/test/cli/commands/init.test.ts",
    "**/test/cli/commands/fix_log_issues.test.ts",
    "**/test/cli/commands/resume.test.ts",
    "**/test/cli/commands/status.test.ts"
  ],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/", "/build/", "\\.d\\.test\\.ts$"],
  "extensionsToTreatAsEsm": [".ts"],
  "coveragePathIgnorePatterns": ["/node_modules/", "/scripts/", "/src/core/"],
  "moduleNameMapper": {
    "^react$": "<rootDir>/node_modules/react/index.js",
    "^react/(.*)$": "<rootDir>/node_modules/react/$1",
    "^ink$": "<rootDir>/node_modules/ink/build/index.js",
    "^@github/copilot-sdk$": "<rootDir>/node_modules/@github/copilot-sdk/dist/index.js",
    "^olinda_shell_interface\\.js/(.+)$": "<rootDir>/node_modules/olinda_shell_interface.js/dist/src/$1.js",
    "^olinda_shell_interface\\.js$": "<rootDir>/node_modules/olinda_shell_interface.js/dist/src/index.js"
  },
  "transform": {
    "^.+\\.tsx?$": "<rootDir>/scripts/jest-typescript-transformer.cjs"
  },
  "maxWorkers": "50%",
  "coverageThreshold": {
    "global": {
      "statements": 83,
      "branches": 64,
      "functions": 90,
      "lines": 83
    },
    "./src/cli/": {
      "statements": 38,
      "branches": 40,
      "functions": 58,
      "lines": 38
    },
    "./src/lib/": {
      "statements": 85,
      "branches": 83,
      "functions": 93,
      "lines": 85
    },
    "./src/orchestrator/": {
      "statements": 87,
      "branches": 82,
      "functions": 75,
      "lines": 87
    },
    "./src/utils/": {
      "statements": 90,
      "branches": 75,
      "functions": 83,
      "lines": 90
    }
  }
}
