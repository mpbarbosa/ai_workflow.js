{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": false,
    "resolveJsonModule": false
  },
  "include": ["src/lib/copilot_sdk_wrapper.ts", "src/types/local-modules.d.ts"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
