{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": false,
    "resolveJsonModule": false,
    "types": ["node"]
  },
  "include": [
    "src/lib/copilot_sdk_wrapper.ts",
    "src/lib/claude_sdk_wrapper.ts",
    "src/lib/ai_provider.ts",
    "src/lib/ai_cache.ts",
    "src/lib/ai_personas.ts",
    "src/cli/tui/components/ErrorDetailPanel.ts",
    "src/cli/tui/components/Header.ts",
    "src/cli/tui/components/HelpOverlay.ts",
    "src/cli/tui/helpers/reusable.ts",
    "src/cli/commands/clean.ts",
    "src/cli/commands/config.ts",
    "src/cli/commands/deploy.ts",
    "src/cli/commands/fix_log_issues.ts",
    "src/cli/commands/init.ts",
    "src/cli/commands/run.ts",
    "src/cli/commands/resume.ts",
    "src/cli/commands/status.ts",
    "src/types/react-shim.d.ts",
    "src/types/local-modules.d.ts",
    "src/types/public-api.d.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
